# Copy this file, rename the copy to .env, and fill in real values.
# Never upload .env to GitHub.

FRONTEND_URL=http://localhost:3000

# Groq AI key from https://console.groq.com/keys
GROQ_API_KEY=paste-your-groq-key-here

# Supabase PostgreSQL URL (Project → Connect → Session pooler).
# Leave empty to use a local SQLite file while developing.
DATABASE_URL=

# Any long random text. Used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string
